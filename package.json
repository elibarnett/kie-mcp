{
  "name": "kie-mcp",
  "mcpName": "io.github.elibarnett/kie-mcp",
  "version": "4.8.0",
  "private": false,
  "type": "module",
  "description": "MCP server for kie.ai — 47+ image models, 80+ video models, 20+ audio tools with deep model intelligence",
  "main": "server.mjs",
  "scripts": {
    "start": "node server.mjs",
    "start:http": "node server.mjs --http",
    "start:http:port": "node server.mjs --http --port=3100",
    "check": "node --check server.mjs",
    "test": "node --test test/*.test.mjs",
    "smoke": "node test/smoke.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1"
  },
  "license": "MIT",
  "author": "Eli Barnett",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elibarnett/kie-mcp.git"
  },
  "keywords": [
    "mcp",
    "kie.ai",
    "claude",
    "ai-image-generation",
    "ai-video-generation",
    "veo",
    "sora",
    "kling",
    "seedance",
    "happyhorse",
    "flux",
    "nano-banana",
    "gpt-image",
    "suno",
    "elevenlabs"
  ],
  "bin": {
    "kie-mcp": "server.mjs"
  },
  "files": [
    "server.mjs",
    "data/",
    "README.md",
    "LICENSE"
  ]
}
